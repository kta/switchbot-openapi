{
  "name": "switchbot-openapi",
  "version": "1.0.0",
  "description": "Auto-updating OpenAPI specification for SwitchBot API",
  "main": "openapi.yaml",
  "type": "module",
  "scripts": {
    "bundle": "redocly bundle src/main.yaml -o openapi.yaml",
    "validate": "redocly lint openapi.yaml",
    "build": "npm run bundle && npm run build:docs && npm run copy:spec && npm run build:mcp",
    "build:docs": "mkdir -p dist && cp docs-template.html dist/index.html",
    "build:mcp": "mkdir -p dist && node scripts/generate-mcp.js",
    "copy:spec": "mkdir -p dist && cp openapi.yaml dist/openapi.yaml",
    "extract": "node scripts/extract-sections.js",
    "test:copilot": "node scripts/test-copilot.js",
    "deploy": "npm run build && npx vercel --prod",
    "deploy:preview": "npm run build && npx vercel"
  },
  "keywords": [
    "switchbot",
    "openapi",
    "api",
    "smart-home"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@redocly/cli": "^2.14.7",
    "yaml": "^2.3.4"
  }
}
